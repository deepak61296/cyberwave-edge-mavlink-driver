# Copy to /etc/cyberwave-mavlink-driver.env and fill in. chmod 600 it —
# it holds the API key.

CYBERWAVE_API_KEY=FILL_ME_IN
CYBERWAVE_TWIN_UUID=de6d4efb-eb86-4ca2-b515-7eba576b83ea

# Pick ONE connection (uncomment + adjust):
# UART to the flight controller (mavutil default 57600 baud — a non-default
# baud is not yet supported via env; roadmap: MAVLINK_BAUD):
#MAVLINK_CONNECTION=/dev/serial0
# mavlink-router endpoint on the same host (the recommended companion
# setup: the router owns the serial port, everything else gets a UDP port):
#MAVLINK_CONNECTION=udpin:127.0.0.1:14553
# WARNING — do NOT point the driver at an ESP8266 mavesp8266 bridge
# (udpin:0.0.0.0:14550): mavesp8266 keeps ONE UDP peer and re-points at
# whoever sent it something last, so the driver silently steals the GCS
# link. Use mavlink-router fan-out instead.
# SITL on the same host (default if unset):
#MAVLINK_CONNECTION=tcp:127.0.0.1:5760

# Uncomment ONLY on a SITL/bench rig — never on a live aircraft:
#CYBERWAVE_ACCEPT_SIM_TELE=1

# The prop joints come from the twin. Name them here (in spin order) only
# for an asset that does not list its joints:
#CYBERWAVE_PROP_JOINTS=prop_1_joint,prop_2_joint,prop_3_joint,prop_4_joint
